rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Default-deny global safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // Health-check / connection test document
    match /test/connection {
      allow get: if true;
    }

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidUser(data) {
      return data.userId is string &&
        data.userId == request.auth.uid &&
        (!('email' in data) || (data.email is string && data.email.size() <= 256)) &&
        (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 128)) &&
        (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 1024)) &&
        (!('coins' in data) || data.coins is number) &&
        (!('unlockedFeatures' in data) || data.unlockedFeatures is list) &&
        (!('guestTrialUsed' in data) || data.guestTrialUsed is bool) &&
        (!('guestBonusApplied' in data) || data.guestBonusApplied is bool) &&
        (!('qrsCreated' in data) || data.qrsCreated is number) &&
        (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 64)) &&
        (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 64));
    }

    function isValidQRCode(data) {
      return data.id is string && isValidId(data.id) &&
        data.userId is string && data.userId == request.auth.uid &&
        data.name is string && data.name.size() <= 256 &&
        data.contentType is string && data.contentType.size() <= 64 &&
        (!('summaryText' in data) || (data.summaryText is string && data.summaryText.size() <= 3000)) &&
        (!('previewThumbnail' in data) || (data.previewThumbnail is string && data.previewThumbnail.size() <= 1000000)) &&
        (!('scanCount' in data) || data.scanCount is number) &&
        (!('lastScannedAt' in data) || data.lastScannedAt is number) &&
        (!('locations' in data) || data.locations is list) &&
        (!('recentScans' in data) || data.recentScans is list) &&
        data.createdAt is number &&
        data.config is map;
    }

    function isValidAnalytics(data) {
      return data.qrId is string && isValidId(data.qrId) &&
        (!('scanCount' in data) || data.scanCount is number) &&
        (!('lastScannedAt' in data) || data.lastScannedAt is number) &&
        (!('locations' in data) || data.locations is list) &&
        (!('recentScans' in data) || data.recentScans is list) &&
        (!('devices' in data) || data.devices is map) &&
        (!('updatedAt' in data) || data.updatedAt is number) &&
        (!('createdAt' in data) || data.createdAt is number);
    }

    function isValidPublicFile(data) {
      return data.id is string && isValidId(data.id) &&
        data.name is string && data.name.size() <= 256 &&
        data.type is string && data.type.size() <= 64 &&
        (!('size' in data) || data.size is number) &&
        data.url is string && data.url.size() <= 1048576 &&
        (!('previewUrl' in data) || (data.previewUrl is string && data.previewUrl.size() <= 350000)) &&
        (!('customSlug' in data) || (data.customSlug is string && data.customSlug.size() <= 128)) &&
        (!('title' in data) || (data.title is string && data.title.size() <= 256)) &&
        (!('description' in data) || (data.description is string && data.description.size() <= 2048)) &&
        (!('updatedAt' in data) || data.updatedAt is number) &&
        data.createdAt is number;
    }

    function isValidUserFile(data) {
      return data.id is string && isValidId(data.id) &&
        data.userId is string && data.userId == request.auth.uid &&
        data.name is string && data.name.size() <= 256 &&
        data.type is string && data.type.size() <= 64 &&
        (!('size' in data) || data.size is number) &&
        data.url is string && data.url.size() <= 1048576 &&
        (!('previewUrl' in data) || (data.previewUrl is string && data.previewUrl.size() <= 350000)) &&
        (!('customSlug' in data) || (data.customSlug is string && data.customSlug.size() <= 128)) &&
        (!('title' in data) || (data.title is string && data.title.size() <= 256)) &&
        (!('description' in data) || (data.description is string && data.description.size() <= 2048)) &&
        (!('userEmail' in data) || (data.userEmail is string && data.userEmail.size() <= 256)) &&
        (!('updatedAt' in data) || data.updatedAt is number) &&
        data.createdAt is number;
    }

    function isValidDynamicLink(data) {
      return data.id is string && isValidId(data.id) &&
        data.targetUrl is string && data.targetUrl.size() <= 2048 &&
        (!('title' in data) || (data.title is string && data.title.size() <= 256)) &&
        (!('contentType' in data) || (data.contentType is string && data.contentType.size() <= 64)) &&
        (!('scanCount' in data) || data.scanCount is number) &&
        (!('lastScannedAt' in data) || data.lastScannedAt is number) &&
        (!('updatedAt' in data) || data.updatedAt is number) &&
        data.createdAt is number;
    }

    // Dynamic QR & Custom Short Link Redirects
    match /dynamic_links/{slug} {
      allow get: if true;
      allow list: if true;
      allow create, update: if isValidId(slug) && isValidDynamicLink(incoming());
      allow delete: if isSignedIn();
    }

    // Publicly accessible files shared via QR
    match /public_files/{fileId} {
      allow get, list: if true;
      allow create, update: if isValidId(fileId) && isValidPublicFile(incoming());
      allow delete: if isSignedIn();
    }

    // User-uploaded files root collection (directly visible in Firebase Console)
    match /files/{fileId} {
      allow get: if true;
      allow list: if isSignedIn();
      allow create: if isSignedIn() && isValidId(fileId) && isValidUserFile(incoming()) && incoming().userId == request.auth.uid;
      allow update: if isSignedIn() && isValidId(fileId) && isValidUserFile(incoming()) && incoming().userId == request.auth.uid;
      allow delete: if isSignedIn() && (resource == null || !('userId' in resource.data) || resource.data.userId == request.auth.uid);
    }

    // User's saved QR codes root collection (directly visible in Firebase Console)
    match /qrcodes/{qrId} {
      allow get: if true;
      allow list: if isSignedIn();
      allow create: if isSignedIn() && isValidQRCode(incoming()) && incoming().userId == request.auth.uid;
      allow update: if isSignedIn() && isValidQRCode(incoming()) && incoming().userId == request.auth.uid;
      allow delete: if isSignedIn() && (resource == null || !('userId' in resource.data) || resource.data.userId == request.auth.uid);
    }

    // Real-time QR scan telemetry and geographic analytics
    match /qr_analytics/{qrId} {
      allow get: if true;
      allow list: if isSignedIn();
      allow create, update: if isValidId(qrId) && isValidAnalytics(incoming());
      allow delete: if isSignedIn();
    }

    // User profile documents
    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow list: if false;
      allow create: if isOwner(userId) && isValidId(userId) && isValidUser(incoming());
      allow update: if isOwner(userId) && isValidId(userId) && isValidUser(incoming()) && incoming().userId == existing().userId;
      allow delete: if isOwner(userId) && isValidId(userId);

      // User's saved QR codes subcollection
      match /qrcodes/{qrId} {
        allow get, list: if isOwner(userId) && isValidId(userId);
        allow create: if isOwner(userId) && isValidId(userId) && isValidQRCode(incoming()) && incoming().userId == request.auth.uid;
        allow update: if isOwner(userId) && isValidId(userId) && isValidQRCode(incoming()) && incoming().userId == request.auth.uid;
        allow delete: if isOwner(userId);
      }

      // User's files subcollection
      match /files/{fileId} {
        allow get, list: if isOwner(userId) && isValidId(userId);
        allow create: if isOwner(userId) && isValidId(userId) && isValidUserFile(incoming()) && incoming().userId == request.auth.uid;
        allow update: if isOwner(userId) && isValidId(userId) && isValidUserFile(incoming()) && incoming().userId == request.auth.uid;
        allow delete: if isOwner(userId);
      }
    }
  }
}
